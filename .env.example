# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
# Backend URL that starts the Google OAuth flow.
# Do not use /api/v1/auth/oauth2/callback/google here because that is the callback endpoint.
# This contract follows the backend OAuth2 module under /api/v1/auth/oauth2.
VITE_GOOGLE_AUTH_URL=http://localhost:8080/api/v1/auth/oauth2/authorize/google
# Backend success handler redirects the browser back to this frontend route with ?code=...
VITE_GOOGLE_REDIRECT_PATH=/oauth2/callback

# Application
VITE_APP_NAME=MyApp
VITE_APP_ENV=development

# Cloudflare Turnstile site key for the public support form. Public by design: it identifies the
# widget, and Cloudflare verifies the paired secret server-side, so this is not a credential.
# The value below is Cloudflare's published always-passes test site key, so a checkout with no
# credentials still renders the widget and the form works locally. Replace before production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
